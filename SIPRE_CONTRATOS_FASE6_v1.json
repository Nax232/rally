{
  "artifact": "SIPRE_CONTRATOS_FASE6_v1",
  "status": "DESIGN_ONLY_NOT_IMPLEMENTED",
  "project": "SIPRE",
  "version": "1.0",
  "dashboard": "Metabase OSS READ_ONLY",
  "priority_model": "AHP geometric mean + fixed ideal TOPSIS",
  "optimization_model": "MILP two stage lexicographic, one destination per sortie",
  "simulation_only": true,
  "schemas": [
    "core",
    "ops",
    "geo",
    "model",
    "planning",
    "audit",
    "experiments",
    "analytics"
  ],
  "api": [
    {
      "method": "POST",
      "path": "/api/v1/emergencies",
      "minimum_role": "OPERATOR",
      "purpose": "Crear emergencia"
    },
    {
      "method": "GET",
      "path": "/api/v1/emergencies",
      "minimum_role": "VIEWER",
      "purpose": "Listar"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/zones",
      "minimum_role": "OPERATOR",
      "purpose": "Registrar zonas"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/reports",
      "minimum_role": "OPERATOR",
      "purpose": "Registrar reportes"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/needs",
      "minimum_role": "OPERATOR",
      "purpose": "Registrar demandas"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/snapshots",
      "minimum_role": "ANALYST",
      "purpose": "Congelar snapshot"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/priority-runs",
      "minimum_role": "ANALYST",
      "purpose": "Ejecutar F4"
    },
    {
      "method": "GET",
      "path": "/api/v1/priority-runs/{run_id}/results",
      "minimum_role": "VIEWER",
      "purpose": "Detalle F4"
    },
    {
      "method": "POST",
      "path": "/api/v1/emergencies/{emergency_id}/optimization-runs",
      "minimum_role": "ANALYST",
      "purpose": "Ejecutar F5"
    },
    {
      "method": "GET",
      "path": "/api/v1/optimization-runs/{run_id}/results",
      "minimum_role": "VIEWER",
      "purpose": "Detalle F5"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{recommendation_id}/accept",
      "minimum_role": "DECISION_MAKER",
      "purpose": "Aprobación humana transaccional"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{recommendation_id}/reject",
      "minimum_role": "DECISION_MAKER",
      "purpose": "Rechazo auditado"
    },
    {
      "method": "POST",
      "path": "/api/v1/recommendations/{recommendation_id}/request-reoptimization",
      "minimum_role": "DECISION_MAKER",
      "purpose": "Reoptimizar"
    },
    {
      "method": "GET",
      "path": "/api/v1/decisions/{decision_id}",
      "minimum_role": "VIEWER",
      "purpose": "Consultar decisión"
    },
    {
      "method": "POST",
      "path": "/api/v1/experiments/runs",
      "minimum_role": "ANALYST",
      "purpose": "Ejecutar experimento"
    }
  ],
  "role_codes": [
    "ADMIN",
    "OPERATOR",
    "ANALYST",
    "DECISION_MAKER",
    "VIEWER"
  ],
  "states": {
