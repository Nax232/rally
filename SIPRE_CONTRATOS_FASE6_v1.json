    "APPROVAL_TRANSACTION_ATOMIC",
    "SIMULATED_FLAG"
  ],
  "run_context": {
    "snapshot_id": "uuid",
    "emergency_id": "uuid",
    "input_revision": "int",
    "network_revision": "int",
    "inventory_revision": "int",
    "criteria_profile_id": "uuid",
    "ahp_profile_id": "uuid",
    "optimization_profile_id": "uuid",
    "as_of_time": "datetime-with-offset"
  },
  "metabase_connection": {
    "data_db": "sipre",
